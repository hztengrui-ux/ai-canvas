<view class="page">
  <view class="row between home-head">
    <view class="col flex-1">
      <view class="h1">{{greeting}}，{{nickname}}</view>
      <view class="sub small home-sub">{{roleText ? roleText + ' · ' : ''}}{{brandName}}</view>
    </view>
    <view class="avatar">{{avatarText}}</view>
  </view>

  <view class="card-dark balance-card" bindtap="goRecharge">
    <view class="row between">
      <view class="col">
        <view class="balance-label">当前余额</view>
        <view class="balance-row">
          <text class="balance-num">{{balance}}</text>
          <text class="balance-unit">{{creditName}}</text>
        </view>
      </view>
      <view class="balance-ring"></view>
    </view>
    <view class="balance-foot row between">
      <text class="balance-tip">每次出图约 {{unitCost}} {{creditName}}</text>
      <text class="balance-more" catchtap="goRecharge">充值 ›</text>
    </view>
  </view>

  <view class="stats-row">
    <view class="card stat-card">
      <view class="stat-num">{{stats.outputsTotal}}</view>
      <view class="muted small">累计产出</view>
    </view>
    <view class="card stat-card stat-card-gap">
      <view class="stat-num">{{stats.todayCount}}</view>
      <view class="muted small">今日产出</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="card err-banner mt-24">
    <view class="row between">
      <text class="small danger-text">{{error}}</text>
      <text class="small brand-text" catchtap="retry">重试</text>
    </view>
  </view>

  <view wx:if="{{tasks.length}}" class="card mt-24">
    <view class="row between section-line">
      <view class="h3">正在生成</view>
      <text class="muted small">{{tasks.length}} 个任务</text>
    </view>
    <view
      class="task-row row between"
      wx:for="{{tasks}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openJob"
    >
      <view class="col flex-1">
        <view class="row">
          <view class="task-dot {{item.state === 'running' ? 'on' : ''}}"></view>
          <text class="task-kind">{{item.kindText}}</text>
        </view>
        <text class="muted tiny task-meta">{{item.stateText}}{{item.timeText ? ' · ' + item.timeText : ''}}</text>
      </view>
      <text class="brand-text small">查看 ›</text>
    </view>
  </view>

  <view class="section-head">
    <view class="h3">最近作品</view>
    <text class="brand-text small" catchtap="goGallery">查看全部 ›</text>
  </view>

  <view wx:if="{{recent.length}}" class="recent-grid">
    <view
      class="recent-item"
      wx:for="{{recent}}"
      wx:key="key"
      data-index="{{index}}"
      bindtap="previewRecent"
    >
      <image wx:if="{{!item.isVideo}}" class="recent-img" src="{{item.fullUrl}}" mode="aspectFill" lazy-load="{{true}}"></image>
      <view wx:else class="recent-video">▶</view>
    </view>
  </view>
  <view wx:else class="card empty-card">
    <view class="empty">还没有作品，先出第一张图吧</view>
    <view class="row center-x">
      <button class="btn btn-primary btn-sm" catchtap="goCreate">去出图</button>
    </view>
  </view>

  <view class="section-head">
    <view class="h3">快捷入口</view>
  </view>
  <view class="quick-row">
    <view class="card quick-card" catchtap="goCreate">
      <view class="quick-icon">✎</view>
      <view class="quick-title">开始出图</view>
      <view class="muted tiny">提示词 / 参考图</view>
    </view>
    <view class="card quick-card quick-card-gap" catchtap="goGallery">
      <view class="quick-icon">▦</view>
      <view class="quick-title">看图库</view>
      <view class="muted tiny">按时间倒序</view>
    </view>
  </view>
</view>
