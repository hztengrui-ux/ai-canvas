.home-head {
  margin-bottom: 8rpx;
}

.home-sub {
  margin-top: 8rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin-left: 20rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 1rpx solid #E5E9F4;
  color: #15171E;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx -12rpx rgba(21, 23, 30, 0.35);
}

.balance-card {
  position: relative;
  margin-top: 28rpx;
  overflow: hidden;
}

.balance-label {
  color: rgba(246, 248, 253, 0.62);
  font-size: 24rpx;
}

.balance-row {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
}

.balance-num {
  color: #D8FA34;
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.balance-unit {
  margin-left: 12rpx;
  color: rgba(246, 248, 253, 0.7);
  font-size: 24rpx;
}

.balance-ring {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 14rpx solid rgba(216, 250, 52, 0.2);
  border-top-color: #D8FA34;
  transform: rotate(-35deg);
}

.balance-foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(246, 248, 253, 0.12);
}

.balance-tip {
  color: rgba(246, 248, 253, 0.55);
  font-size: 22rpx;
}

.balance-more {
  color: #D8FA34;
  font-size: 24rpx;
}

.stats-row {
  display: flex;
  margin-top: 24rpx;
}

.stat-card {
  flex: 1;
  padding: 24rpx 28rpx;
}

.stat-card-gap {
  margin-left: 20rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #15171E;
  line-height: 1.2;
}

.err-banner {
  padding: 22rpx 28rpx;
}

.task-row {
  padding: 20rpx 0;
  border-top: 1rpx solid #E5E9F4;
}

.task-row:first-of-type {
  border-top: none;
}

.task-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background-color: #C4CDE2;
}

.task-dot.on {
  background-color: #D8FA34;
  box-shadow: 0 0 0 6rpx rgba(216, 250, 52, 0.28);
}

.task-kind {
  font-size: 28rpx;
  color: #15171E;
  font-weight: 600;
}

.task-meta {
  margin-top: 6rpx;
  margin-left: 24rpx;
}

.recent-grid {
  display: flex;
  flex-wrap: wrap;
}

.recent-item {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  height: 200rpx;
  margin: 0 20rpx 20rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #F4F6FC;
}

.recent-item:nth-child(3n) {
  margin-right: 0;
}

.recent-img {
  width: 100%;
  height: 100%;
  display: block;
}

.recent-video {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background-color: #15171E;
  color: #D8FA34;
  font-size: 34rpx;
}

.empty-card {
  text-align: center;
  padding: 40rpx 28rpx;
}

.empty-card .empty {
  padding: 12rpx 0 24rpx;
}

.quick-row {
  display: flex;
}

.quick-card {
  flex: 1;
}

.quick-card-gap {
  margin-left: 20rpx;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background-color: rgba(216, 250, 52, 0.35);
  color: #181A0C;
  font-size: 32rpx;
}

.quick-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #15171E;
}
