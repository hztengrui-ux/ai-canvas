<view class="page">
  <view class="card profile-card">
    <view class="row">
      <view class="avatar-lg">{{avatarText}}</view>
      <view class="col flex-1 ml-24">
        <view class="h2 ellipsis">{{nickname || '未登录'}}</view>
        <view wx:if="{{username && username !== nickname}}" class="muted small mt-4">@{{username}}</view>
        <view class="row wrap mt-8">
          <view class="tag tag-brand" wx:for="{{roleNames}}" wx:key="*this">{{item}}</view>
          <view wx:if="{{!roleNames.length}}" class="tag">无角色</view>
        </view>
      </view>
    </view>

    <view class="divider mt-24"></view>

    <view class="row between mt-24">
      <view class="col flex-1" bindtap="goRecharge">
        <text class="muted tiny">当前余额 · 点击充值</text>
        <view class="balance-line">
          <text class="balance-inline">{{balance}}</text>
          <text class="muted small balance-unit-inline">{{creditName}}</text>
        </view>
      </view>
      <view class="row profile-actions">
        <button class="btn btn-ghost btn-sm" bindtap="goCreate">去出图</button>
        <button class="btn btn-primary btn-sm ml-16" bindtap="goRecharge">充值</button>
      </view>
    </view>
  </view>

  <view class="section-head">
    <view class="h3">修改密码</view>
  </view>
  <view class="card">
    <view class="field">
      <view class="field-label">当前密码</view>
      <input
        class="input"
        password="{{true}}"
        value="{{oldPassword}}"
        data-field="oldPassword"
        placeholder="请输入当前密码"
        placeholder-class="input-ph"
        bindinput="onPwdInput"
      />
    </view>
    <view class="field">
      <view class="field-label">新密码</view>
      <input
        class="input"
        password="{{true}}"
        value="{{newPassword}}"
        data-field="newPassword"
        placeholder="至少 6 位"
        placeholder-class="input-ph"
        bindinput="onPwdInput"
      />
    </view>
    <view class="field">
      <view class="field-label">确认新密码</view>
      <input
        class="input"
        password="{{true}}"
        value="{{confirmPassword}}"
        data-field="confirmPassword"
        placeholder="再输入一次新密码"
        placeholder-class="input-ph"
        bindinput="onPwdInput"
      />
    </view>
    <button
      class="btn btn-primary btn-block {{pwdSubmitting ? 'is-busy' : ''}}"
      bindtap="submitPassword"
      hover-class="none"
    >{{pwdSubmitting ? '提交中…' : '保存新密码'}}</button>
    <view class="muted tiny mt-12 pwd-tip">修改成功后，其他设备上的登录会立即下线，本机保持登录。</view>
  </view>

  <button class="btn btn-danger btn-block mt-24" bindtap="logout" hover-class="none">退出登录</button>

  <view class="section-head">
    <view class="h3">服务端地址（调试）</view>
  </view>
  <view class="card">
    <view class="row between">
      <text class="muted tiny">当前生效</text>
      <text class="tiny ink ellipsis server-now">{{baseUrl}}</text>
    </view>
    <view wx:if="{{baseUrlPending}}" class="saved-hint tiny">
      已保存 {{baseUrlSaved}}，重启小程序后生效
    </view>
    <view class="field mt-16">
      <view class="field-label">改成电脑的局域网地址，例如 http://192.168.1.8:5199</view>
      <input
        class="input"
        value="{{baseUrlDraft}}"
        data-field="baseUrlDraft"
        placeholder="http://127.0.0.1:5199"
        placeholder-class="input-ph"
        bindinput="onBaseUrlInput"
      />
    </view>
    <view class="row">
      <button class="btn btn-ink btn-sm" bindtap="saveBaseUrl">保存</button>
      <button class="btn btn-ghost btn-sm ml-16" bindtap="resetBaseUrl">恢复默认</button>
    </view>
    <view class="muted tiny mt-12 debug-tip">保存后需重启小程序生效；开发者工具里还要勾选「不校验合法域名」，电脑端用 AI_CANVAS_BIND=0.0.0.0 启动。</view>
  </view>

  <view class="version">
    <view class="muted tiny">跨多多 AI 创作台 · 手机端 v{{appVersion}}</view>
    <view class="muted tiny">服务端 v{{serverVersion}}</view>
  </view>
</view>
