{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "跨多多科技 · 视觉令牌",
  "version": "1.0.0",
  "updatedAt": "2026-10-25",
  "source": "跨多多 AI 创作台（ai-canvas）src/themes.css · studio-polish.css · LoginView.vue",
  "principles": [
    "中性灰打底、墨黑做结构与主文字",
    "荧光绿只做行为色（可点的东西），一个界面出现 2~3 处",
    "不用蓝色做主色系"
  ],
  "color": {
    "neutral": {
      "bg": { "light": "#eceff2", "dark": "#0c0e14" },
      "surface": { "light": "#ffffff", "dark": "#141721" },
      "surfaceHover": { "light": "#f5f6f8", "dark": "#1b1f2b" },
      "border": { "light": "#e4e7eb", "dark": "#262b39" },
      "borderStrong": { "light": "#d3d8de", "dark": "#363d4f" }
    },
    "text": {
      "primary": { "light": "#15171e", "dark": "#f4f6fc" },
      "secondary": { "light": "#5a6274", "dark": "#a3acc0" },
      "tertiary": { "light": "#838ca0", "dark": "#7a8398" },
      "placeholder": { "light": "#a6adbd", "dark": "#5c6478" }
    },
    "action": {
      "ink": { "light": "#15171e", "dark": "#f4f6fc", "usage": "主按钮底 / 当前项 / 深色舞台" },
      "lime": { "light": "#d8fa34", "dark": "#ddff45", "usage": "主 CTA、当前项（配墨黑或反色文字）", "contrastOnInk": "13.8:1" },
      "limeDeep": { "light": "#bce600", "dark": "#c6ef10", "usage": "悬停加深" },
      "limeInk": { "light": "#181a0c", "dark": "#15171e", "usage": "荧光绿底上的文字" },
      "greenInk": { "light": "#4e9e00", "usage": "白底上的绿色文字/图标（约 4:1）" },
      "greenBright": { "light": "#86d000", "usage": "图标、描边、悬停" },
      "accentGradient": "linear-gradient(135deg, #ebff7a 0%, #d8fa34 46%, #bce600 100%)"
    },
    "semantic": {
      "success": { "light": "#2e9e6b", "dark": "#43c88a" },
      "warning": { "light": "#d8971a", "dark": "#e8b23c" },
      "danger": { "light": "#e0553f", "dark": "#f4795f" },
      "info": { "light": "#5a6274", "dark": "#9aa5bb" }
    },
    "canvas": {
      "bg": { "light": "#edf0f3", "dark": "#0a0d14" },
      "dot": { "light": "#c7ced6", "dark": "#2c344a" }
    },
    "glass": {
      "fill": { "light": "rgba(255,255,255,0.72)", "dark": "rgba(20,23,33,0.74)" },
      "border": { "light": "rgba(255,255,255,0.9)", "dark": "rgba(140,152,184,0.14)" },
      "blur": "26px"
    }
  },
  "radius": {
    "sm": "10px",
    "md": "14px",
    "lg": "20px",
    "xl": "28px",
    "pill": "999px"
  },
  "shadow": {
    "base": "0 1px 2px rgba(21,23,30,.04), 0 10px 26px -20px rgba(21,23,30,.35)",
    "raised": "0 2px 8px rgba(21,23,30,.05), 0 24px 48px -26px rgba(21,23,30,.4)",
    "lime": "0 6px 16px -8px rgba(188,230,0,.85)"
  },
  "typography": {
    "family": "-apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "familyMono": "ui-monospace, Consolas, monospace",
    "size": {
      "caption": "10.5px",
      "xs": "11.5px",
      "sm": "12.5px",
      "base": "13.5px",
      "button": "14.5px",
      "cardTitle": "20px",
      "pageTitle": "30px",
      "hero": "50px"
    },
    "weight": { "regular": 400, "medium": 600, "bold": 700, "heavy": 800 },
    "lineHeight": { "tight": 1.2, "text": 1.7 }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px" },
  "motion": {
    "ease": "cubic-bezier(.4,0,.2,1)",
    "fast": "120ms",
    "normal": "160ms",
    "slow": "240ms"
  },
  "components": {
    "button": {
      "default": { "height": "32px", "padding": "0 13px", "radius": "10px" },
      "primary": { "height": "40px", "padding": "0 18px", "radius": "12px", "bg": "lime", "fg": "limeInk", "shadow": "lime" },
      "cta": { "height": "50px", "padding": "0 20px", "radius": "13px", "usage": "登录/落地页主行动" }
    },
    "iconButton": { "size": "30px", "radius": "8px", "iconSize": "15px", "hoverBg": "surfaceHover", "activeBg": "lime", "activeFg": "limeInk" },
    "railButton": { "size": "40px", "radius": "12px", "iconSize": "17px" },
    "pillToggle": { "height": "32px", "radius": "999px", "padding": "0 12px" },
    "chip": { "height": "28px", "radius": "999px" },
    "card": { "radius": "20px", "padding": "14px 16px", "border": "1px solid border" },
    "input": { "height": "48px", "radius": "13px", "focusRing": "0 0 0 4px rgba(216,250,52,.28)" }
  },
  "icons": {
    "set": "Element Plus Icons（线性描边）",
    "sizes": { "inline": "15px", "rail": "17px", "hero": "20px" },
    "colorRule": "默认 text-3(#838ca0)；悬停 text；激活为荧光绿底 + 墨黑图标",
    "strokeRule": "统一线性风格，不混用面性图标；同一容器内图标尺寸一致",
    "semantic": {
      "Aim": "无限画布 / 聚焦",
      "Files": "全自动批量 / 文件夹批次",
      "Grid": "批量节点 / 网格",
      "Picture": "图片素材",
      "MagicStick": "AI 生成 / 魔法",
      "Document": "文档 / 详情页",
      "Collection": "素材库",
      "Avatar": "人像 / 模特",
      "Setting": "设置",
      "Moon / Sunny": "外观（深色/浅色）",
      "Download": "导出 / 下载",
      "Delete": "删除",
      "QuestionFilled": "帮助"
    }
  }
}
